# Novaryns environment variables.
#
# 推荐用 docker compose 部署(见 DEPLOY.md)。先复制为 .env 并生成下面两个密钥，
# 再打开站点走「首启配置向导」填 OpenAI API Key。
# 手动部署(npm run build && npm start)时,复制本文件为 `.env.local` 再填。

# --- Docker Compose ---
POSTGRES_USER=novaryns
POSTGRES_DB=novaryns
# 必填。建议：openssl rand -hex 24
POSTGRES_PASSWORD=
# 必填。建议：openssl rand -hex 32；首次运行后永远不要修改。
SETTINGS_SECRET=
# 可选：支付订单轮询 cookie 的独立 HMAC 密钥；留空时复用 SETTINGS_SECRET。
# 若填写，同样建议使用 `openssl rand -hex 32`，并保持所有实例一致。
PAYMENT_POLL_SECRET=
# 对外端口；80 被占用时改为 8080。
HTTP_PORT=80
# 可选：使用 GitHub Actions 发布的镜像，例如 ghcr.io/owner/repo:latest。
# 留空时 docker compose up --build 使用本地源码构建。
APP_IMAGE=

# --- Database (Postgres) ---
# 必填(生产)。用户/积分/作品/设置都存这里,schema 首次访问自动建。
# docker compose 会按上面的 Postgres 变量自动生成；手动部署时在这里填完整地址。
DATABASE_URL=

# --- Referrals ---
# 邀请好友首次有效付费后发给邀请人的积分；设为 0 可停发，邀请关系仍会记录。
REFERRAL_REWARD_CREDITS=30

# --- Settings encryption ---
# 用于 AES-256-GCM 加密落库的 API Key 等敏感设置。设一个长随机串,设完永远别改。
# Docker Compose 复用上面的 SETTINGS_SECRET；手动部署也必须设置同名变量。

# --- AI image generation (OpenAI) ---
# 可留空:首启向导 / 管理后台里填,加密存数据库(推荐)。也可在此用 env 提供。
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
# 单实例低成本部署建议设为 1，避免多个生图请求同时占用内存和接口额度。
GEN_MAX_CONCURRENT=1
# 中国大陆服务器直连不了 api.openai.com:填任意 OpenAI 兼容中转/网关地址即可
# (自建海外中转或第三方中转均可,如 https://your-relay.example.com/v1)
OPENAI_BASE_URL=

# --- AI video generation (Replicate) ---
# 电商视频真实出片：Seedance 1.5 Pro / Kling 2.1 Master。
# 在 https://replicate.com/account/api-tokens 创建；仅服务端读取，不要放进 NEXT_PUBLIC_*。
REPLICATE_API_TOKEN=

# --- WeChat Pay callback verification (required when WeChat Pay is enabled) ---
# 微信支付平台证书 PEM 或平台公钥 PEM；也可填其 DER 的 base64 单行形式。
# WXPAY_PLATFORM_SERIAL 填对应平台证书序列号或平台公钥 ID。
WXPAY_PLATFORM_PUBLIC_KEY=
WXPAY_PLATFORM_SERIAL=

# --- Storage ---
# 默认本地磁盘(MEDIA_DIR,docker 卷 /data/media),零配置可用。
# 配齐 R2_*(Cloudflare R2,S3 兼容)则自动切换对象存储。
MEDIA_DIR=./data/media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Auth (Supabase Auth, 可选) ---
# 三个都填启用真实多用户登录(多用户注册为 Pro 能力);留空为单机模式。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 管理员邮箱(该 Supabase 用户可见 /admin 管理后台)
ADMIN_EMAIL=

# --- Edition / Pro license ---
# 开源版留空即可。购买 Pro 商业授权后:
#   NOVARYNS_EDITION=pro + PRO_LICENSE_KEY=NOVA-XXXX-...(或在首启向导里填 Key)
NOVARYNS_EDITION=
PRO_LICENSE_KEY=
# License 校验服务器(默认官方,不用改)
LICENSE_SERVER_URL=

# --- Branding (可选,build 期内联;运行时品牌请用后台「品牌与白标」) ---
NEXT_PUBLIC_BRAND_NAME=Picset
NEXT_PUBLIC_BRAND_LOGO=/picset-mark.svg
NEXT_PUBLIC_BRAND_EMAIL=
